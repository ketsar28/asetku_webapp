DATABASE_URL="mysql://root:root@localhost:3306/asset_db"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
FINE_PER_DAY=10000

# Pembayaran online DINONAKTIFKAN. Untuk mengaktifkan nanti:
# PAYMENT_MODE="midtrans" (atau "demo" untuk simulasi) dan NEXT_PUBLIC_ONLINE_PAYMENT="true"
PAYMENT_MODE="off"
NEXT_PUBLIC_ONLINE_PAYMENT="false"
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
APP_URL="http://localhost:3000"

# Notifikasi email (opsional, mis. Gmail: smtp.gmail.com + App Password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AsetKu <noreply@domain-anda.com>"
# Notifikasi WhatsApp via Fonnte (opsional): token dari fonnte.com
FONNTE_TOKEN=""
# Rahasia untuk endpoint pengingat jatuh tempo (/api/cron/reminders)
CRON_SECRET="ganti-dengan-string-acak"
# Folder penyimpanan upload (foto aset & bukti transfer)
UPLOAD_DIR="uploads"
# Info rekening tujuan transfer manual (tampil di form upload bukti)
NEXT_PUBLIC_TRANSFER_INFO="BCA 1234567890 a.n. PT AsetKu Corporate"

# Pengeluaran manual oleh peran Keuangan >= batas ini menunggu persetujuan admin (Rp)
APPROVAL_LIMIT="5000000"

# Pesanan belum dibayar lebih dari ... jam dibatalkan otomatis (dijalankan oleh /api/cron/reminders)
PAY_DEADLINE_HOURS="24"
NEXT_PUBLIC_PAY_DEADLINE_HOURS="24"
# Jumlah file backup yang disimpan oleh npm run db:backup
BACKUP_KEEP="14"
