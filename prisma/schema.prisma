generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
  finance
  user
  employee
}

enum Condition {
  good
  damaged
  maintenance
}

enum AssetStatus {
  available
  borrowed
  disposed
  sold
}

enum LogAction {
  created
  updated
  condition_change
  maintenance
}

enum LoanStatus {
  pending
  approved
  rejected
  on_loan
  returned
  overdue
}

enum MaintStatus {
  scheduled
  in_progress
  completed
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  @@map("departments")
}
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(user)
  phone        String?  @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  walletBalance  Decimal   @default(0) @map("wallet_balance") @db.Decimal(14, 2)
  pinHash        String?   @map("pin_hash")
  pinFailed      Int       @default(0) @map("pin_failed")
  pinLockedUntil DateTime? @map("pin_locked_until")
  departmentId Int?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  loans        LoanRequest[] @relation("Borrower")
  approvals    LoanRequest[] @relation("Approver")
  logs         AssetLog[]
  purchases    Purchase[]
  employeeId   Int?     @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  @@index([role])
  @@map("users")
}
model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?  @db.Text
  assets      Asset[]
  @@map("categories")
}
model Asset {
  id           Int         @id @default(autoincrement())
  assetCode    String      @unique @map("asset_code")
  name         String
  categoryId   Int         @map("category_id")
  category     Category    @relation(fields: [categoryId], references: [id])
  brand        String?
  model        String?
  serialNumber String?     @map("serial_number")
  imageUrl     String?     @map("image_url") @db.Text
  condition    Condition   @default(good)
  status       AssetStatus @default(available)
  location     String?
  purchaseDate DateTime?   @map("purchase_date")
  purchaseCost Decimal?    @map("purchase_cost") @db.Decimal(14, 2)
  rentalRate   Decimal     @default(0) @map("rental_rate") @db.Decimal(14, 2)
  rentalUnit   String      @default("day") @map("rental_unit") @db.VarChar(10)
  salePrice    Decimal?    @map("sale_price") @db.Decimal(14, 2)
  soldAt       DateTime?   @map("sold_at")
  description  String?     @db.Text
  specs        String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  logs         AssetLog[]
  loans        LoanRequest[]
  maintenance  MaintenanceRecord[]
  opnameItems  StockOpnameItem[]
  purchases    Purchase[]
  @@index([status, condition])
  @@index([categoryId])
  @@map("assets")
}
model AssetLog {
  id          Int       @id @default(autoincrement())
  assetId     Int       @map("asset_id")
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actionType  LogAction @map("action_type")
  description String @db.Text
  performedBy Int       @map("performed_by")
  user        User      @relation(fields: [performedBy], references: [id])
  timestamp   DateTime  @default(now())
  @@index([assetId])
  @@map("asset_logs")
}
model LoanRequest {
  id                 Int        @id @default(autoincrement())
  requestNumber      String     @unique @map("request_number")
  userId             Int        @map("user_id")
  user               User       @relation("Borrower", fields: [userId], references: [id])
  assetId            Int        @map("asset_id")
  asset              Asset      @relation(fields: [assetId], references: [id])
  requestDate        DateTime   @default(now()) @map("request_date")
  startDate          DateTime   @map("start_date")
  expectedReturnDate DateTime   @map("expected_return_date")
  actualReturnDate   DateTime?  @map("actual_return_date")
  status             LoanStatus @default(pending)
  purpose            String @db.Text
  adminNote          String?    @map("admin_note") @db.Text
  fineAmount         Decimal    @default(0) @map("fine_amount") @db.Decimal(14, 2)
  rentalFee          Decimal    @default(0) @map("rental_fee") @db.Decimal(14, 2)
  insurance          Boolean    @default(false)
  insuranceFee       Decimal    @default(0) @map("insurance_fee") @db.Decimal(14, 2)
  vatAmount          Decimal    @default(0) @map("vat_amount") @db.Decimal(14, 2)
  totalAmount        Decimal    @default(0) @map("total_amount") @db.Decimal(14, 2)
  groupNo            String?    @map("group_no") @db.VarChar(40)
  paymentStatus      String     @default("unpaid") @map("payment_status") @db.VarChar(10)
  paidAt             DateTime?  @map("paid_at")
  paymentOrderId     String?    @map("payment_order_id") @db.VarChar(80)
  proofUrl           String?    @map("proof_url") @db.VarChar(255)
  termsAcceptedAt    DateTime?  @map("terms_accepted_at")
  extensionOf        String?    @map("extension_of") @db.VarChar(40)
  damageFee          Decimal    @default(0) @map("damage_fee") @db.Decimal(14, 2)
  paymentMethod      String     @default("cash") @map("payment_method") @db.VarChar(12)
  bankName           String?    @map("bank_name") @db.VarChar(60)
  accountName        String?    @map("account_name") @db.VarChar(100)
  accountNo          String?    @map("account_no") @db.VarChar(40)
  approvedBy         Int?       @map("approved_by")
  approver           User?      @relation("Approver", fields: [approvedBy], references: [id])
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  @@index([userId])
  @@index([assetId])
  @@index([status, expectedReturnDate])
  @@index([paymentOrderId])
  @@map("loan_requests")
}
model MaintenanceRecord {
  id             Int         @id @default(autoincrement())
  assetId        Int         @map("asset_id")
  asset          Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceDate DateTime   @map("maintenance_date")
  completionDate DateTime?   @map("completion_date")
  cost           Decimal?    @db.Decimal(14, 2)
  description    String @db.Text
  vendor         String?
  status         MaintStatus @default(scheduled)
  @@index([assetId])
  @@map("maintenance_records")
}

enum TxType {
  income
  expense
}

model Transaction {
  id            Int      @id @default(autoincrement())
  type          TxType
  category      String   @db.VarChar(80)
  amount        Decimal  @db.Decimal(14, 2)
  description   String   @db.Text
  txDate        DateTime @map("tx_date")
  source        String   @default("manual") @db.VarChar(20)
  assetId       Int?     @map("asset_id")
  refNo         String?  @map("ref_no") @db.VarChar(60)
  paymentMethod String   @default("cash") @map("payment_method") @db.VarChar(12)
  bankName      String?  @map("bank_name") @db.VarChar(60)
  accountName   String?  @map("account_name") @db.VarChar(100)
  accountNo     String?  @map("account_no") @db.VarChar(40)
  createdBy     Int      @map("created_by")
  createdByName String   @map("created_by_name") @db.VarChar(120)
  voidedAt      DateTime? @map("voided_at")
  voidReason    String?   @map("void_reason") @db.VarChar(255)
  approval      String    @default("approved") @db.VarChar(10)
  attachmentUrl String?   @map("attachment_url") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([txDate])
  @@index([type])
  @@map("transactions")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String    @db.VarChar(120)
  body      String    @db.Text
  link      String?   @db.VarChar(120)
  ref       String?   @unique @db.VarChar(80)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model Employee {
  id          Int       @id @default(autoincrement())
  employeeNo  String    @unique @map("employee_no") @db.VarChar(20)
  name        String    @db.VarChar(120)
  position    String    @db.VarChar(40)
  gender      String    @default("L") @db.VarChar(1)
  birthDate   DateTime? @map("birth_date")
  nik         String?   @db.VarChar(20)
  phone       String?   @db.VarChar(30)
  email       String?   @db.VarChar(120)
  address     String?   @db.Text
  joinDate    DateTime  @map("join_date")
  status      String    @default("active") @db.VarChar(10)
  baseSalary  Decimal   @default(0) @map("base_salary") @db.Decimal(14, 2)
  allowance   Decimal   @default(0) @db.Decimal(14, 2)
  kpiScore    Int       @default(80) @map("kpi_score")
  kpiNote     String?   @map("kpi_note") @db.VarChar(255)
  bankName    String?   @map("bank_name") @db.VarChar(60)
  accountName String?   @map("account_name") @db.VarChar(100)
  accountNo   String?   @map("account_no") @db.VarChar(40)
  photoUrl    String?   @map("photo_url") @db.VarChar(255)
  idPhotoUrl  String?   @map("id_photo_url") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  payrolls    Payroll[]
  user        User?
  overtimes   OvertimeRequest[]
  claims      Reimbursement[]

  @@index([position])
  @@map("employees")
}

model Payroll {
  id             Int       @id @default(autoincrement())
  slipNo         String    @unique @map("slip_no") @db.VarChar(40)
  employeeId     Int       @map("employee_id")
  employee       Employee  @relation(fields: [employeeId], references: [id])
  period         String    @db.VarChar(7)
  baseSalary     Decimal   @map("base_salary") @db.Decimal(14, 2)
  allowance      Decimal   @db.Decimal(14, 2)
  kpiScore       Int       @map("kpi_score")
  kpiBonus       Decimal   @map("kpi_bonus") @db.Decimal(14, 2)
  overtime       Decimal   @default(0) @db.Decimal(14, 2)
  bpjs           Decimal   @db.Decimal(14, 2)
  otherDeduction Decimal   @default(0) @map("other_deduction") @db.Decimal(14, 2)
  net            Decimal   @db.Decimal(14, 2)
  note           String?   @db.VarChar(255)
  status         String    @default("draft") @db.VarChar(10)
  paidAt         DateTime? @map("paid_at")
  paymentMethod  String?   @map("payment_method") @db.VarChar(12)
  bankName       String?   @map("bank_name") @db.VarChar(60)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([employeeId, period])
  @@index([period])
  @@map("payrolls")
}

model WalletTx {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  type         String    @db.VarChar(14)
  amount       Decimal   @db.Decimal(14, 2)
  balanceAfter Decimal   @map("balance_after") @db.Decimal(14, 2)
  status       String    @default("done") @db.VarChar(10)
  description  String    @db.VarChar(255)
  refNo        String?   @map("ref_no") @db.VarChar(60)
  bankName     String?   @map("bank_name") @db.VarChar(60)
  accountName  String?   @map("account_name") @db.VarChar(100)
  accountNo    String?   @map("account_no") @db.VarChar(40)
  note         String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("wallet_transactions")
}

model PeriodClose {
  id           Int      @id @default(autoincrement())
  period       String   @unique @db.VarChar(7)
  closedAt     DateTime @default(now()) @map("closed_at")
  closedBy     Int      @map("closed_by")
  closedByName String   @map("closed_by_name") @db.VarChar(120)

  @@map("period_closes")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  userName  String   @map("user_name") @db.VarChar(120)
  action    String   @db.VarChar(40)
  entity    String   @db.VarChar(30)
  entityId  String?  @map("entity_id") @db.VarChar(40)
  detail    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Budget {
  id       Int     @id @default(autoincrement())
  period   String  @db.VarChar(7)
  category String  @db.VarChar(80)
  amount   Decimal @db.Decimal(14, 2)

  @@unique([period, category])
  @@map("budgets")
}

model Reconciliation {
  id            Int      @id @default(autoincrement())
  channel       String   @db.VarChar(12)
  bank          String   @default("") @db.VarChar(60)
  asOf          DateTime @map("as_of")
  bookBalance   Decimal  @map("book_balance") @db.Decimal(14, 2)
  actualBalance Decimal  @map("actual_balance") @db.Decimal(14, 2)
  diff          Decimal  @db.Decimal(14, 2)
  note          String?  @db.VarChar(255)
  createdByName String   @map("created_by_name") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("reconciliations")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

model StockOpname {
  id            Int               @id @default(autoincrement())
  name          String            @db.VarChar(120)
  status        String            @default("open") @db.VarChar(10)
  createdByName String            @map("created_by_name") @db.VarChar(120)
  createdAt     DateTime          @default(now()) @map("created_at")
  closedAt      DateTime?         @map("closed_at")
  items         StockOpnameItem[]

  @@map("stock_opnames")
}

model StockOpnameItem {
  id        Int         @id @default(autoincrement())
  opnameId  Int         @map("opname_id")
  opname    StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  assetId   Int         @map("asset_id")
  asset     Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status    String      @default("pending") @db.VarChar(10)
  checkedAt DateTime?   @map("checked_at")
  checkedBy String?     @map("checked_by") @db.VarChar(120)

  @@unique([opnameId, assetId])
  @@index([opnameId, status])
  @@map("stock_opname_items")
}

enum PurchaseStatus {
  pending
  approved
  rejected
  completed
}
/// Pesanan pembelian aset (tanpa tanggal & durasi). Satu baris per aset, dikelompokkan dengan groupNo.
model Purchase {
  id              Int            @id @default(autoincrement())
  orderNumber     String         @unique @map("order_number")
  groupNo         String?        @map("group_no") @db.VarChar(40)
  userId          Int            @map("user_id")
  user            User           @relation(fields: [userId], references: [id])
  assetId         Int            @map("asset_id")
  asset           Asset          @relation(fields: [assetId], references: [id])
  status          PurchaseStatus @default(pending)
  purpose         String?        @db.Text
  adminNote       String?        @map("admin_note") @db.Text
  price           Decimal        @default(0) @db.Decimal(14, 2)
  insurance       Boolean        @default(false)
  insuranceFee    Decimal        @default(0) @map("insurance_fee") @db.Decimal(14, 2)
  vatAmount       Decimal        @default(0) @map("vat_amount") @db.Decimal(14, 2)
  totalAmount     Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  paymentStatus   String         @default("unpaid") @map("payment_status") @db.VarChar(10)
  paidAt          DateTime?      @map("paid_at")
  paymentOrderId  String?        @map("payment_order_id") @db.VarChar(80)
  proofUrl        String?        @map("proof_url") @db.VarChar(255)
  paymentMethod   String         @default("cash") @map("payment_method") @db.VarChar(12)
  bankName        String?        @map("bank_name") @db.VarChar(60)
  accountName     String?        @map("account_name") @db.VarChar(100)
  accountNo       String?        @map("account_no") @db.VarChar(40)
  termsAcceptedAt DateTime?      @map("terms_accepted_at")
  approvedBy      Int?           @map("approved_by")
  handedOverAt    DateTime?      @map("handed_over_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  @@index([userId])
  @@index([assetId])
  @@index([groupNo])
  @@index([status])
  @@map("purchases")
}

/// Pengajuan lembur karyawan. Setelah disetujui admin, nominalnya masuk ke slip gaji (kolom lembur).
model OvertimeRequest {
  id         Int       @id @default(autoincrement())
  employeeId Int       @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id])
  workDate   DateTime  @map("work_date") @db.Date
  startTime  String    @map("start_time") @db.VarChar(5)
  endTime    String    @map("end_time") @db.VarChar(5)
  hours      Decimal   @db.Decimal(5, 2)
  dayType    String    @default("workday") @map("day_type") @db.VarChar(10)
  activity   String    @db.Text
  photoUrl   String    @map("photo_url") @db.VarChar(255)
  amount     Decimal   @default(0) @db.Decimal(14, 2)
  status     String    @default("pending") @db.VarChar(10)
  adminNote  String?   @map("admin_note") @db.Text
  reviewedBy Int?      @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  payPeriod  String?   @map("pay_period") @db.VarChar(7)
  payrollId  Int?      @map("payroll_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  @@index([employeeId, workDate])
  @@index([status])
  @@index([payPeriod])
  @@map("overtime_requests")
}
/// Pengajuan reimburse biaya penunjang kantor (bensin, makan, dan lain-lain) lengkap dengan foto nota.
model Reimbursement {
  id            Int       @id @default(autoincrement())
  claimNo       String    @unique @map("claim_no") @db.VarChar(40)
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  category      String    @db.VarChar(60)
  expenseDate   DateTime  @map("expense_date") @db.Date
  amount        Decimal   @db.Decimal(14, 2)
  description   String    @db.Text
  receiptUrl    String    @map("receipt_url") @db.VarChar(255)
  status        String    @default("pending") @db.VarChar(10)
  adminNote     String?   @map("admin_note") @db.Text
  reviewedBy    Int?      @map("reviewed_by")
  paidAt        DateTime? @map("paid_at")
  paymentMethod String?   @map("payment_method") @db.VarChar(12)
  bankName      String?   @map("bank_name") @db.VarChar(60)
  createdAt     DateTime  @default(now()) @map("created_at")
  @@index([employeeId])
  @@index([status])
  @@map("reimbursements")
}
